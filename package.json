{
  "name": "chronos-atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "codex": "node scripts/launch-codex.mjs",
    "doctor": "node scripts/doctor.mjs",
    "bootstrap": "node scripts/bootstrap.mjs --install",
    "verify:starter": "node scripts/verify-starter.mjs",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint apps packages tests/local && node scripts/check-hygiene.mjs",
    "test:product": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "node scripts/typecheck.mjs",
    "dev": "node scripts/web.mjs dev",
    "build": "node scripts/web.mjs build",
    "start": "node scripts/web.mjs start",
    "provider:a": "node apps/provider/src/server.mjs --identity fixture-retry --port 4311",
    "provider:b": "node apps/provider/src/server.mjs --identity fixture-events --port 4312",
    "worker:check": "node apps/worker/src/main.mjs --check",
    "verify": "node scripts/verify-starter.mjs && node scripts/typecheck.mjs && node scripts/web.mjs build",
    "verify:release": "node scripts/release-gate.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "vitest": "5.0.3",
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.0",
    "@types/pg": "8.23.1"
  },
  "packageManager": "bun@1.4.1"
}
