{
  "name": "chronos-atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "codex": "node scripts/launch-codex.mjs",
    "doctor": "node scripts/doctor.mjs",
    "bootstrap": "node scripts/bootstrap.mjs --install",
    "verify:starter": "node scripts/verify-starter.mjs",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint apps packages tests scripts/evaluate.ts && node scripts/check-hygiene.mjs && node scripts/check-ai-providers.mjs",
    "test:product": "vitest run --maxWorkers=2",
    "test:browser": "playwright test",
    "mcp": "bun packages/sdk/src/mcp.ts",
    "sdk:example": "bun packages/sdk/examples/fixture.ts",
    "evaluate": "bun scripts/evaluate.ts",
    "typecheck": "node scripts/typecheck.mjs",
    "dev": "node scripts/web.mjs dev",
    "build": "node scripts/web.mjs build",
    "start": "node scripts/web.mjs start",
    "provider:a": "node scripts/fixtures.mjs provider-a",
    "provider:b": "node scripts/fixtures.mjs provider-b",
    "worker:check": "node scripts/worker.mjs --build",
    "verify": "node scripts/verify-starter.mjs && node scripts/typecheck.mjs && node scripts/web.mjs build",
    "verify:release": "node scripts/release-gate.mjs",
    "verify:ai": "node scripts/check-ai-providers.mjs",
    "worker": "node scripts/worker.mjs",
    "verify:integrations": "bun scripts/verify-integrations.ts",
    "provider:testnet": "node scripts/provider.mjs",
    "provider:install": "node scripts/provider.mjs --install",
    "provider:check": "node scripts/provider.mjs --build",
    "fixture:provider-a": "node scripts/fixtures.mjs provider-a",
    "fixture:provider-b": "node scripts/fixtures.mjs provider-b",
    "fixture:mcp": "node scripts/fixtures.mjs mcp"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "vitest": "5.0.3",
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.0",
    "@types/pg": "8.23.1",
    "@electric-sql/pglite": "0.5.8",
    "@modelcontextprotocol/sdk": "1.32.0",
    "mppx": "0.13.1",
    "viem": "2.57.2"
  },
  "packageManager": "bun@1.4.1"
}
