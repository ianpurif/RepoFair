# Starter defaults. Blank values are unavailable, not a demo bypass.
ATLAS_MODE=fixture
NEXT_PUBLIC_ATLAS_MODE=fixture
APP_ORIGIN=http://localhost:3000
DATABASE_URL=
# Trusted CA file for TLS verification; never disable certificate checking.
DATABASE_SSL_CA_FILE=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Alternative to inline PEM: local downloaded RSA private-key file. Configure only one.
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Configure only after consulting official Tempo/MPP documentation.
TEMPO_RPC_URL=
TEMPO_CHAIN_ID=
TEMPO_TOKEN_ADDRESS=
PROVIDER_RECIPIENT=
# Headless callers supply their own signer. No key is shipped or stored here.
# Never use NEXT_PUBLIC_ for a secret or private signing key.

# Server-side application AI. Enable explicitly before approved API usage.
ATLAS_AI_ENABLED=false
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-code-3
VOYAGE_RERANK_MODEL=rerank-2.5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
