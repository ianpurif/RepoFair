# Starter defaults. Blank values are unavailable, not a demo bypass.
ATLAS_MODE=fixture
NEXT_PUBLIC_ATLAS_MODE=fixture
APP_ORIGIN=http://localhost:3000
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Application runtime model is separate from Codex's development models.
OPENAI_API_KEY=
ATLAS_GENERATION_MODEL=
ATLAS_EMBEDDING_MODEL=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Configure only after consulting official Tempo/MPP documentation.
TEMPO_RPC_URL=
TEMPO_CHAIN_ID=
TEMPO_TOKEN_ADDRESS=
PROVIDER_RECIPIENT=
# Headless callers supply their own signer. No key is shipped or stored here.
# Never use NEXT_PUBLIC_ for a secret or private signing key.
