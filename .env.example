# Product defaults. Fixtures require separate explicit development commands.
ATLAS_MODE=tempo-testnet
NEXT_PUBLIC_ATLAS_MODE=tempo-testnet
ATLAS_FIXTURES_ENABLED=false
APP_ORIGIN=http://localhost:3000
DATABASE_URL=
# Trusted CA file for TLS verification; never disable certificate checking.
DATABASE_SSL_CA_FILE=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Alternative to inline PEM: local downloaded RSA private-key file. Configure only one.
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Configure only after consulting official Tempo/MPP documentation.
TEMPO_RPC_URL=
TEMPO_CHAIN_ID=42431
TEMPO_TOKEN_ADDRESS=0x20c0000000000000000000000000000000000000
# Trusted Atlas issuer. Separate independent providers receive only its public key.
ATLAS_PUBLIC_ORIGIN=
ATLAS_PUBLICATION_SIGNING_KEY_FILE=
# Authenticated headless SDK/MCP; token file is read per request, never sent to a provider.
ATLAS_API_ORIGIN=
ATLAS_SESSION_TOKEN_FILE=
ATLAS_ALLOW_LOCAL_DEVELOPMENT=false
# Independent provider database, identity, endpoint and challenge secret. No central DB fallback.
ATLAS_PROVIDER_DATABASE_URL=
ATLAS_PROVIDER_DATABASE_SSL_CA_FILE=
ATLAS_PROVIDER_ID=
ATLAS_PROVIDER_ORIGIN=
ATLAS_PROVIDER_AUTHORIZATION_ISSUER=
ATLAS_PROVIDER_ISSUER_PUBLIC_KEY_FILE=
ATLAS_PROVIDER_MPP_SECRET_FILE=
ATLAS_PROVIDER_RECIPIENT=
ATLAS_PROVIDER_PRICE_UNITS=
ATLAS_PROVIDER_REALM=
ATLAS_PROVIDER_PORT=4311
# Headless callers supply their own signer. No key is shipped or stored here.
# Never use NEXT_PUBLIC_ for a secret or private signing key.

# Server-side application AI. Enable explicitly before approved API usage.
ATLAS_AI_ENABLED=false
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-code-3
VOYAGE_RERANK_MODEL=rerank-2.5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
