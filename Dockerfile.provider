FROM oven/bun:1.4.1 AS bun-tool

FROM node:22-bookworm-slim AS build
COPY --from=bun-tool /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /srv/atlas
COPY . .
RUN bun install --frozen-lockfile
RUN node scripts/provider.mjs --build
RUN bun build apps/provider/src/install.ts --target=node --packages=external --no-env-file --env=disable --outfile=apps/provider/.atlas/install.mjs

FROM node:22-bookworm-slim
ENV NODE_ENV=production \
    ATLAS_PROVIDER_BIND_HOST=0.0.0.0 \
    ATLAS_PROVIDER_PORT=4311
WORKDIR /srv/atlas
COPY --from=build --chown=node:node /srv/atlas /srv/atlas
USER node
EXPOSE 4311
CMD ["node", "apps/provider/.atlas/provider.mjs"]
