FROM oven/bun:1.4.1 AS bun-tool

FROM node:22-bookworm-slim AS build
COPY --from=bun-tool /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /srv/atlas
COPY . .
RUN bun install --frozen-lockfile
RUN node scripts/worker.mjs --build

FROM node:22-bookworm-slim
ENV NODE_ENV=production \
    ATLAS_PARSER_SCRIPT=/srv/atlas/packages/core/.atlas/repository-parser-child.mjs
WORKDIR /srv/atlas
COPY --from=build --chown=node:node /srv/atlas /srv/atlas
USER node
CMD ["node", "apps/worker/.atlas/worker-main.mjs"]
